# Copy to .env — never commit real secrets.

# Production (AWS) values are noted as "prod:". Secrets live in AWS Secrets Manager, never here.

# Database (docker-compose + backend)
DB_NAME=sahyatri
DB_USER=sahyatri
DB_PASSWORD=sahyatri
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/sahyatri
DB_POOL_SIZE=10

# Backend
PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth (backend)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
AUTH_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=

# URLs, uploads, mail (backend)
PUBLIC_BASE_URL=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:5173
# Uploads: local (dev) or s3 (prod, bucket in AWS_REGION; credentials from the ECS task role)
STORAGE_TYPE=local
UPLOAD_DIR=./data/uploads
S3_UPLOADS_BUCKET=
AWS_REGION=ap-south-1
# Email: log (dev, printed to the console) or ses (prod; MAIL_FROM's domain must be verified in SES)
MAIL_PROVIDER=log
# MAIL_FROM defaults to "Sahyatri <no-reply@sahyatri.local>" (application.yml). If you set it, don't quote
# it — the backend reads this file as .properties — and don't `source` the file in a shell.
# MAIL_FROM=Sahyatri <no-reply@sahyatri.local>

# OTP SMS: log (dev) or msg91 (prod; needs TRAI DLT-approved sender + OTP template using ##otp##)
SMS_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Rate limits (backend). prod: RATE_LIMIT_CLIENT_IP_HEADER=CloudFront-Viewer-Address
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CLIENT_IP_HEADER=

# Admin & catalog (backend)
ADMIN_EMAILS=
GUIDE_SHARE_BPS=7000

# Bookings & payments (backend) — Razorpay test-mode keys in dev
BOOKING_HOLD_TTL=10m
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend (Vite)
# prod: empty (same origin; CloudFront routes /api/* to the backend)
VITE_API_BASE_URL=http://localhost:8081
VITE_GOOGLE_CLIENT_ID=
